<?xml version="1.0" encoding="UTF-8"?>
<configuration status="WARN">

	<Appenders>
		<RollingFile name="FileLogger" fileName="D:/Arittek_Tasks/Nadra_System/logs/app.log" filePattern="D:/Arittek_Tasks/Nadra_System/logs/app-%d{dd-MM-yyyy}-%i.log">
		
			<patternLayout>
				<pattern>
					%d{yy-MM-dd HH:mm:ss} [%t] %-5p %Logger{36} -%m%n
				</pattern>
			</patternLayout>
			<Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
		</RollingFile>
	</Appenders>
	
	<Loggers>
		<logger name="com.controller" level="info" additivity="false">
		
			<AppenderRef ref="FileLogger" />
		</logger>
		
	
		<Root level="info">
            <AppenderRef ref="FileLogger"/>
        </Root>
	</Loggers>

	


</configuration>